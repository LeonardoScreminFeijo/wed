# Renomeie este arquivo para .env e coloque suas URLs reais
VITE_API_URL_LOGIN=XXXXXXX
VITE_API_URL_RSVP=XXXXXXX
VITE_PIX_TESTE=XXXXXXX
VITE_API_URL_MURAL=XXXXXXX
VITE_API_URL_LOGS=XXXXXXX
VITE_API_URL_ADMIN_RSVP=XXXXXXX

# Mercado Pago (Payment Bricks) — Public Key é exposta no client, Access Token NUNCA
VITE_MP_PUBLIC_KEY=XXXXXXX
MP_ACCESS_TOKEN=XXXXXXX

# ── Desenvolvimento local ────────────────────────────────────
# Para usar o mock de login local em vez da API real:
#   1. Defina VITE_API_URL_LOGIN=/api/dev-login
#   2. Preencha DEV_LOGIN e DEV_SENHA abaixo
# Variáveis sem prefixo VITE_ nunca são embutidas no bundle do browser.
# O endpoint /api/dev-login só existe quando o servidor Vite está rodando.
DEV_LOGIN=XXXXXXX
DEV_SENHA=XXXXXXX